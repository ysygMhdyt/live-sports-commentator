{
    "manifest_version": 3,
    "name": "Live Sports Commentator",
    "version": "1.0",
    "description": "A Chrome extension that provides live commentary for sports videos",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "*://*/*",
        "https://api.lemonfox.ai/*",
        "https://openrouter.ai/*"
    ],
    "background": {
        "service_worker": "dist/background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "web_accessible_resources": [{
        "resources": ["content.js"],
        "matches": ["<all_urls>"]
    }],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}
  